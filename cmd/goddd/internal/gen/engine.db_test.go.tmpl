package {{.PackageName}}db

import (
	"context"
	"testing"

	"{{.ModuleName}}/internal/core/{{.PackageName}}"
)

// Test{{.Name}}CRUD 验证 {{.Name}} 的 Create、List、Count、GetByID、Update、Delete
func Test{{.Name}}CRUD(t *testing.T) {
	t.Parallel()
	db := setupTestDB(t)
	store := New{{.Name}}(db)
	ctx := context.Background()

	m := {{.PackageName}}.{{.Name}}{}
	if err := store.Create(ctx, &m); err != nil {
		t.Fatalf("Create 失败: %v", err)
	}

	t.Run("List", func(t *testing.T) {
		in := &{{.PackageName}}.List{{.Name}}Input{}
		in.Size = 10
		list, total, err := store.List(ctx, in)
		if err != nil {
			t.Fatalf("List 失败: %v", err)
		}
		if total != 1 || len(list) != 1 {
			t.Fatalf("期望 total=1 len=1, got total=%d len=%d", total, len(list))
		}
	})

	t.Run("Count", func(t *testing.T) {
		in := &{{.PackageName}}.List{{.Name}}Input{}
		count, err := store.Count(ctx, in)
		if err != nil {
			t.Fatalf("Count 失败: %v", err)
		}
		if count != 1 {
			t.Fatalf("期望 count=1, got %d", count)
		}
	})

	t.Run("GetByID", func(t *testing.T) {
		got, err := store.GetByID(ctx, m.ID)
		if err != nil {
			t.Fatalf("GetByID 失败: %v", err)
		}
		if got.ID != m.ID {
			t.Fatalf("期望 ID=%v, got %v", m.ID, got.ID)
		}
	})

	t.Run("Update", func(t *testing.T) {
		out := &{{.PackageName}}.{{.Name}}{ID: m.ID}
		if err := store.Update(ctx, out, func(b *{{.PackageName}}.{{.Name}}) error {
			return nil
		}); err != nil {
			t.Fatalf("Update 失败: %v", err)
		}
		if out.ID != m.ID {
			t.Fatalf("期望 ID=%v, got %v", m.ID, out.ID)
		}
	})

	t.Run("Delete", func(t *testing.T) {
		out := &{{.PackageName}}.{{.Name}}{ID: m.ID}
		if err := store.Delete(ctx, out); err != nil {
			t.Fatalf("Delete 失败: %v", err)
		}
		// 验证已删除
		_, err := store.GetByID(ctx, m.ID)
		if err == nil {
			t.Fatalf("删除后 GetByID 应报错")
		}
	})

	t.Run("Delete_Idempotent", func(t *testing.T) {
		out := &{{.PackageName}}.{{.Name}}{ID: m.ID}
		if err := store.Delete(ctx, out); err != nil {
			t.Fatalf("幂等删除不应报错, got: %v", err)
		}
	})
}
